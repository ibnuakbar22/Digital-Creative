# ===== BACKEND (letakkan salinan sebagai .env di root atau backend/) =====
NODE_ENV=development
PORT=4000
# PostgreSQL / Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
# Isi dengan string acak >= 32 karakter, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=you@example.com
# Hasil dari: cd backend && npm run hash-password -- "passwordKamu"
# Tanda $ di hash harus ditulis apa adanya; jika di platform hosting, tempel di kolom env tanpa tanda kutip.
ADMIN_PASSWORD_HASH=
# Domain frontend (pisahkan koma jika lebih dari satu)
FRONTEND_ORIGIN=http://localhost:5173
# Supabase Storage (bucket publik untuk gambar cover)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=project-covers

# ===== FRONTEND (frontend/.env) =====
# Kosongkan saat development (Vite memakai proxy ke :4000). Isi URL API saat production.
VITE_API_URL=
